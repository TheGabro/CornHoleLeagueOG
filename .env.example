# Copia questo file in `.env` (che è in .gitignore) e compila i valori.
# In produzione le stesse variabili vengono passate al container, non da file.

# Chiave usata da Django per firmare sessioni e token CSRF. Generane una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambiami

# True solo in sviluppo: mostra le pagine di errore dettagliate e serve i file statici da solo.
DEBUG=True

# Host da cui Django accetta richieste (separati da virgola). In prod: il dominio dell'app.
ALLOWED_HOSTS=localhost,127.0.0.1

# Se assente → SQLite locale (db.sqlite3). In prod → stringa di connessione Neon, es.:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
